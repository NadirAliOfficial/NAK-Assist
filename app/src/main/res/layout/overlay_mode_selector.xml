<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F21C1C1E"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ NAK Assist"
            android:textColor="#4F8CFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCloseMode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#636366"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Away Mode -->
    <Button android:id="@+id/btnAwayModeToggle"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:text="💤 Away Mode: OFF"
        android:backgroundTint="#2C2C2E"
        android:textColor="#4F8CFF" android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Keep Screen On — local only, no interaction with Fiverr -->
    <Button android:id="@+id/btnKeepScreenOn"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:text="🔆 Keep Screen On: OFF"
        android:backgroundTint="#2C2C2E"
        android:textColor="#8E8E93" android:textSize="14sp"/>

</LinearLayout>
